# Copy to .env locally. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentnegotiate
SESSION_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_OUTPUT_TOKENS=4096
# Simulated seller policy for the hackathon demo; set explicitly in deployment.
MERCHANT_MINIMUM_TOTAL_CENTS=30000
B4_ENABLED=false
# Startup migrations apply domain first, then payments; coordinate on shared databases.
B2_RUN_MIGRATIONS=false
# Keep the standalone USD 1 harness and fault injection disabled during B4.
B2_HARNESS_ENABLED=false
B3_CAPTURE_ENABLED=false
B3_ALLOW_FAULT_INJECTION=false
B5_CAPTURE_ENABLED=false
B5_ALLOW_FAULT_INJECTION=false
# Optional, explicitly simulated stock; never reset an existing reservation.
B4_SEED_SCENARIO=
B4_ACKNOWLEDGE_SYNTHETIC_STOCK=false
# Optional: random merchant-only secret (at least 32 characters) for B4 reconciliation.
B4_MERCHANT_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Vite variables are public in browser bundles; only use the PayPal client ID here.
VITE_PAYPAL_CLIENT_ID=
VITE_API_BASE_URL=
